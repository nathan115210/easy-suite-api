{
  "name": "easy-suite-api",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:app": "node scripts/dev-app.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "ci:local": "node scripts/check-act-version.mjs && act -j base",
    "ci:local:list": "node scripts/check-act-version.mjs && act -l",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:check": "turbo run db:check",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose down",
    "dev:db:reset": "docker compose down -v && docker compose up -d postgres",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
